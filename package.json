{
  "name": "zetter-font-change",
  "version": "1.0.0",
  "private": true,
  "description": "Zetter（z-etter.com）のフォントをアップデート前のシステムフォントに戻す Chrome 拡張機能",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
